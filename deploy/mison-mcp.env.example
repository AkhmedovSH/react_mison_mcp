# /etc/mison-mcp.env — настройки удалённого MCP-сервера. Все строки необязательны.
# Права: sudo chmod 640 /etc/mison-mcp.env (секретов здесь нет, но порядок такой же, как у остальных .env).

# Адрес партнёрского API Mison (по умолчанию боевой)
# MISON_API_URL=https://backend.mison.uz/api/integrations/v1

# Потолок возможностей сервера. Клиент может только сузить его заголовками X-Mison-Groups и X-Mison-Readonly,
# расширить — нет. Группы: core,reports,receipts,inventories,transfers,menu,orders,reservations,attendance
# MISON_MCP_GROUPS=core,reports,receipts,inventories,transfers,menu,orders,reservations,attendance

# true — инструменты записи не подключаются никому. Хороший режим для первого запуска
# MISON_MCP_READONLY=true

# Запросов в минуту на один ключ (по умолчанию 300)
# MISON_MCP_HTTP_RATE_LIMIT=300

# Неудачных попыток входа в минуту с одного адреса (по умолчанию 30)
# MISON_MCP_HTTP_AUTH_FAIL_LIMIT=30

# Источники, которым разрешён CORS (нужен только браузерным клиентам вроде MCP Inspector), через запятую
# MISON_MCP_ALLOWED_ORIGINS=

# Максимальный размер запроса, байт (по умолчанию 1000000)
# MISON_MCP_MAX_BODY=1000000

# Потолок размера одного ответа инструмента, знаков (по умолчанию 60000)
# MISON_MCP_MAX_CHARS=60000

# off — не писать построчный журнал запросов
# MISON_MCP_LOG=on
